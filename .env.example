# Generate with: uv run fusionify-audio generate-token
FAI_API_TOKEN=
# Local test: http://127.0.0.1:8000 ; deployment: your actual public HTTPS origin
FAI_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Exact public hostnames permitted for direct HTTPS media imports, comma separated
FAI_IMPORT_HOSTS=
# Optional external audio interpretation; no key is needed for DSP or rendering
GEMINI_API_KEY=
FAI_GEMINI_MODEL=
